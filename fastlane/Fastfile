lane :upload_app do
  zealot(
    endpoint: ENDPOINT,
    token: TOKEN,
    channel_key: CHANNEL_KEY,
    changelog: 'This is a test changelog',
    file: '/home/icyleaf/Development/ruby/app-info/spec/fixtures/apps/android-31.aab'
