end

lane :upload_debug_file do
  # 上传 iOS dSYM 调试文件
  zealot_debug_file(
    endpoint: ENDPOINT,
    token: TOKEN,
    channel_key: CHANNEL_KEY,
    platform: :ios,
    xcode_scheme: 'AppName',
    verify_ssl: false
  )

  # 上传 Android Proguard 调试文件
  zealot_debug_file(
    endpoint: ENDPOINT,
    token: TOKEN,
    channel_key: CHANNEL_KEY,
    platform: :android,
    android_build_type: 'release',
    android_flavor: 'store',
    release_version: '1.1.0',
    build_version: '1',
    overwrite: true
  )

  # 上传指定 zip file 调试文件
  zealot_debug_file(
    endpoint: ENDPOINT,
    token: TOKEN,
    channel_key: CHANNEL_KEY,
    zip_file: 'path/to/your/zip_file',
    release_version: '1.1.0',
    build_version: '1',
    verify_ssl: false
  )
end

